# =============================================================================
# Cragfoge CRM — self-host environment
# Copy to deploy/.env.selfhost and edit before `docker compose … up`.
# =============================================================================

# Public URL of the CRM (nginx). Used for cookies, auth redirects, CORS.
WEB_ORIGIN=http://localhost
API_BASE_URL=http://localhost
HTTP_PORT=80

# Strong secret for session signing (min 32 characters). CHANGE THIS.
AUTH_SECRET=change-me-to-a-long-random-secret-32+

# For first boot / demo without SMTP, leave verification off.
# Set true once real SMTP is configured.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Logging
LOG_LEVEL=info

# Process role is set by compose (api / worker). Do not override here unless you know why.
# PROCESS_ROLE=all

# Database — API runtime MUST use crm_app (RLS). Admin/migrator are only for entrypoint migrate.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=crm
DATABASE_URL=postgresql://crm_app:crm_app@postgres:5432/crm
DATABASE_URL_MIGRATOR=postgresql://crm_migrator:crm_migrator@postgres:5432/crm
# Superuser used once at start to ensure roles + run migrations. Never expose publicly.
DATABASE_URL_ADMIN=postgresql://postgres:change-me-postgres-password@postgres:5432/crm

REDIS_URL=redis://redis:6379

# Object storage (MinIO profile or any S3-compatible API)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=crm
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=change-me-minio-secret

# Email (Mailpit profile for local/demo; use real SMTP in production)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@localhost
MAILPIT_UI_PORT=8025

# Deployment
DEPLOYMENT_MODE=selfhost
# Ed25519 public key (SPKI DER, base64). Required in production selfhost.
# Dev key below is for first boot only — replace with your own for real installs.
LICENSE_PUBLIC_KEY=MCowBQYDK2VwAyEAIcPFud0rsovYyM/OW4on1lJ/5tN9VWMhc5N+qnmE3aQ=

# Optional observability
SENTRY_DSN=

# Rate limits (optional overrides)
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=300
# API_KEY_RATE_LIMIT_TTL_MS=60000
# API_KEY_RATE_LIMIT_MAX=60
