{
  "name": "@cragfoge/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate": "drizzle-kit generate",
    "migrate": "bun scripts/migrate.ts",
    "migrate:lock": "bun scripts/migrate-with-lock.ts",
    "perf:records": "bun scripts/perf-records.ts"
  },
  "dependencies": {
    "@cragfoge/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.2"
  }
}
