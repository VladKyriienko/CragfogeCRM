{
  "name": "cragfoge-crm",
  "private": true,
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "typescript": "6.0.3",
    "drizzle-orm": "0.45.3"
  },
  "scripts": {
    "dev": "bun run db:migrate && bunx turbo run dev",
    "build": "bunx turbo run build",
    "typecheck": "bunx turbo run typecheck",
    "lint": "prettier --check . && bunx turbo run lint",
    "format": "prettier --write .",
    "test": "bun run db:migrate && bunx turbo run test",
    "test:coverage": "bun run db:migrate && bunx turbo run test:coverage",
    "db:migrate": "bun --filter @cragfoge/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
