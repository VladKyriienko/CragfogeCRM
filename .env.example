# Copy to .env to override defaults. Local defaults match docker-compose.yml,
# so the API and web app start without this file.

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_BASE_URL=http://localhost:3000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
AUTH_SECRET=dev-only-auth-secret-change-me-32chars

# API runtime role. Never point this at postgres or crm_migrator.
DATABASE_URL=postgresql://crm_app:crm_app@localhost:5432/crm
# Migrations and seeds.
DATABASE_URL_MIGRATOR=postgresql://crm_migrator:crm_migrator@localhost:5432/crm
# Creates roles. Local Docker superuser. Do not give this URL to the API process in production.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/crm

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crm
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minioadmin

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@localhost

# Global API rate limit (per IP). Defaults: 2000/min in development, 300/min in production.
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=2000

# Per-API-key rate limit (Redis sliding window). Defaults: 60 requests / 60s.
# API_KEY_RATE_LIMIT_TTL_MS=60000
# API_KEY_RATE_LIMIT_MAX=60

# Optional. Leave empty to disable Sentry.
SENTRY_DSN=

# BullMQ process role: api | worker | all (default all for local dev).
# PROCESS_ROLE=all

# Override email verification (unset = required only in production).
# AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Deployment mode: selfhost (default, offline license) or cloud (Stripe).
DEPLOYMENT_MODE=selfhost

# Cloud only (required when DEPLOYMENT_MODE=cloud). Not read in selfhost mode.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# Self-host only. Ed25519 public key (SPKI DER, base64). Dev/test default is baked in;
# required in production selfhost. Private key never goes in the repo — use
# `bun --filter @cragfoge/api generate-license` with LICENSE_PRIVATE_KEY.
# LICENSE_PUBLIC_KEY=
